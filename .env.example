# Blob backend settings. Copy to backend/.env (the backend reads .env from its working
# directory) and fill in real values. Never commit .env.
# Values below are the defaults unless marked "required". Slice = first slice that needs it.

# --- S1: Hermes Agent (required) ---
HERMES_URL=http://127.0.0.1:8642          # required; OpenAI-compatible base URL, no /v1
HERMES_KEY=change-me                      # required; sent as Authorization: Bearer
HERMES_MODEL=hermes-agent                 # required; the only id Hermes 0.23.1 lists
# HERMES_HISTORY_MODE=session             # only "session" is built (S0 test result)
# HERMES_CONNECT_S=5                      # connect timeout, seconds
# HERMES_TOTAL_S=75                       # total timeout, seconds (reason timeout/hermes)
# SESSION_IDLE_S=300                      # new X-Hermes-Session-Id after this idle time
# HERMES_ALERTS_URL=http://blob.blob.svc.cluster.local:80   # Blob's /alerts as Hermes reaches it (in the skill Blob sends)

# --- S1: turn watchdogs ---
# LISTEN_WATCHDOG_S=30                    # no utterance after tap (reason timeout/listen)
# TURN_WATCHDOG_S=120                     # from utterance to turn_done (reason timeout/turn)

# --- S1: speech models ---
# STT_MODEL=large-v3                      # faster-whisper model; on a CPU-only machine: small
# STT_COMPUTE=int8_float16                # CTranslate2 compute type; on CPU: int8
# NO_SPEECH_MAX=0.6                       # mean no-speech probability above this = empty
# SILENCE_RMS=0.01                        # served to the page for tail_silence_ms
# KOKORO_DEVICE=cpu                       # cpu or cuda
# TTS_MAX_CHARS=1200                      # longer replies are cut at a sentence end
# MODEL_DIR=/data/models                  # model cache; Kokoro files download here on start

# --- S1: storage and server ---
# RETENTION_DAYS=14                       # turns rows older than this are deleted
# HOST=0.0.0.0
# PORT=8000
# DB_PATH=/data/blob.db                   # SQLite on block or local storage, not NFS
# STATIC_DIR=web/dist                     # built page; from backend/ use ../web/dist

# --- S2: devices and tokens ---
DEVICE_TOKEN=change-me                    # required; browsers send it in hello and /device-config
# DEVICES_PATH=config/devices.json        # per-device sound/wake flags; from backend/ use ../config/devices.json
ALERT_TOKEN=change-me                     # required; sources send it to /alerts as Authorization: Bearer

# --- S3: hands-free ---
# FOLLOWUP_MAX=3                          # follow-up listens in a row (server guard against loops)
# FOLLOWUP_LISTEN_S=6                     # served to the page by GET /device-config
# LISTEN_NO_SPEECH_S=8                    # served to the page by GET /device-config

# --- S4: alerts and timers ---
# QUIET_HOURS=                            # served to the page; format 22:00-07:00, browser local time
# TIMER_RULE=on                           # on/off: voice timers without Hermes; off once Hermes calls /alerts

# --- Development only ---
# BLOB_FAKE_MODELS=0                      # 1 = canned transcript and a tone instead of the models
# BLOB_FAKE_TRANSCRIPT=¿Qué hora es?      # what the fake speech-to-text "hears" (quiet audio = empty)
# BLOB_FAKE_LANG=es
